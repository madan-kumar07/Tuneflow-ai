# ==========================================
# TuneFlow AI - Backend Environment Variables
# ==========================================

# Server Port (Render automatically supplies PORT)
PORT=8080

# Database Configuration (Railway / Render PostgreSQL)
# Railway supplies DATABASE_URL, or use DB_URL, DB_USERNAME, DB_PASSWORD
DATABASE_URL=jdbc:postgresql://localhost:5432/tuneflow
DB_URL=jdbc:postgresql://localhost:5432/tuneflow
DB_USERNAME=postgres
DB_PASSWORD=postgres123

# JWT Secret (minimum 256-bit string)
JWT_SECRET=your_super_secret_jwt_key_must_be_at_least_256_bits_long

# CORS Origins (Comma-separated origins, or * for all)
CORS_ALLOWED_ORIGINS=https://tuneflow-ai.vercel.app,http://localhost:5173

# YouTube Data API Key
YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# Email / SMTP Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=onboarding@resend.dev
